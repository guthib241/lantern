MODEL_API_KEY=your-key-here
LANTERN_ROOTS=/path/to/Documents
LANTERN_PERSONA=smug
# Forms (computer use). Develop on Spark; use muse-wonder-1.0 for final runs.
LANTERN_FORMS_MODEL=muse-spark-1.3
LANTERN_CUA_PROTOCOL=native
# LANTERN_CUA_COORDS=pixel
LANTERN_FORMS_HEADLESS=0
# LANTERN_FORMS_DOMAINS=forms.example.org
# Channels (comma list): fake | whatsapp | telegram | none
LANTERN_CHANNELS=fake
# WhatsApp Cloud API (System User token, not the 24-hour one)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=pick-any-random-string
# LANTERN_WHATSAPP_OWNER=919876543210
# Telegram fallback
# TELEGRAM_BOT_TOKEN=
# LANTERN_TELEGRAM_OWNER=
# Email: fake | smtp (Gmail: turn on 2-step verification, create an app password)
LANTERN_EMAIL_MODE=fake
# LANTERN_SMTP_USER=you@gmail.com
# LANTERN_SMTP_PASSWORD=your-16-char-app-password
# LANTERN_EMAIL_FROM=you@gmail.com
# LANTERN_SENT_FOLDER=[Gmail]/Sent Mail
