MODEL_API_KEY=your-key-here
# Folders Lantern may see; several are separated by ; on Windows and : elsewhere
LANTERN_ROOTS=/path/to/Documents
LANTERN_PERSONA=smug
# Spending limits in dollars, checked in code before every model call ("off" turns one off)
LANTERN_BUDGET_USD=150
# LANTERN_DAILY_BUDGET_USD=10
LANTERN_TASK_BUDGET_USD=3
# Forms (computer use). Develop on Spark; use muse-wonder-1.0 for final runs.
LANTERN_FORMS_MODEL=muse-spark-1.3
LANTERN_CUA_PROTOCOL=native
# LANTERN_CUA_COORDS=pixel
LANTERN_FORMS_HEADLESS=0
# LANTERN_FORMS_DOMAINS=forms.example.org
# Channels (comma list): fake | whatsapp | telegram | none
LANTERN_CHANNELS=fake
# WhatsApp Cloud API (System User token, not the 24-hour one)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=pick-any-random-string
# LANTERN_WHATSAPP_OWNER=919876543210
# Telegram fallback
# TELEGRAM_BOT_TOKEN=
# LANTERN_TELEGRAM_OWNER=
# Email: fake | smtp (Gmail: turn on 2-step verification, create an app password)
LANTERN_EMAIL_MODE=fake
# LANTERN_SMTP_USER=you@gmail.com
# LANTERN_SMTP_PASSWORD=your-16-char-app-password
# LANTERN_EMAIL_FROM=you@gmail.com
# LANTERN_SENT_FOLDER=[Gmail]/Sent Mail
# Several tasks at once with `lantern --serve` (scheduler.py): how many run side by side
# LANTERN_WORKERS=3
# Learned routines (compiler.py): verify each new or healed routine on a throwaway copy of the site.
# For the demo, run a second portal (python demo/portal/server.py --port 8771) and point this at it.
# Without it, a routine is checked dry on the real site, up to its first submit.
# LANTERN_ROUTINE_SANDBOX=http://127.0.0.1:8771
# Screenshots sent to the computer-use model: raw, masked (black boxes over your own profile values), or decoy
# (S7: stand-in values in their place; Lantern types the real ones only here). scripts/eval_privacy.py measures all
# three; raw stays the default until it has been run with the real models.
# LANTERN_SCREENSHOTS=raw
# The planner/reader split (security.py) is on with `lantern --serve`. off only to compare, never for real use.
# LANTERN_READER=on
# Sleep (sleep.py): each night `lantern --serve` checks every learned routine where nothing real can happen,
# repairs what drifted and sends a morning digest. Local time, or off.
# LANTERN_SLEEP_AT=03:30
# Muse Spark Open on Baseten (lantern/baseten.py): optional second cloud lane, off by default. Muse Spark via
# the Meta API stays the default. Public content only: private zones are refused and go to Glimmer alone.
# LANTERN_BASETEN=on
# BASETEN_API_KEY=your-baseten-key        (cloud sandbox: injected-by-proxy, the network secret adds the real one)
# LANTERN_BASETEN_EFFORT=low              (low | medium | high | xhigh)
